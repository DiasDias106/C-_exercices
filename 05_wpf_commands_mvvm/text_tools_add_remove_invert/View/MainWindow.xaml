<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="3" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Sair" Foreground="red" FontSize="20"></MenuItem>
            </Menu>
        </DockPanel>
        <Label Content="Introduza o seu nome" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="txtnome" Grid.Row="1" Grid.ColumnSpan="3" Margin="30,68,30,0" VerticalAlignment="Top" Height="68" ></TextBox>
        <Label Content="Introduza pequena mensagem" Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="txtadicionar" Grid.Row="2" Grid.ColumnSpan="3" Margin="30,68,30,0" VerticalAlignment="Top" Height="68" ></TextBox>
        <Button  Grid.Column="0" Grid.Row="3" FontSize="20" Margin="30,58,28,57" >Adicionar</Button>
        <Button Grid.Column="1" Grid.Row="3"  FontSize="20" Margin="30,58,28,57" >Apagar</Button>
        <Button Grid.Column="2" Grid.Row="3" FontSize="20" Margin="30,58,28,57" >Reverter</Button>
        <Label Content="Resultado" Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="txtresult" Grid.Row="4" Grid.ColumnSpan="3" Margin="30,68,30,0" VerticalAlignment="Top" Height="68" ></TextBox>
    </Grid>
</Window>
