<Window x:Class="musica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:musica"
        xmlns:ctrl="clr-namespace:musica.Controller"
        mc:Ignorable="d"
        Background="Red"
        Title="MainWindow" Height="800" Width="800">
    <Window.Resources>
        <ctrl:Controlo x:Key="cont" ></ctrl:Controlo>
    </Window.Resources>
    <Grid>
        <Button Margin="202,494,186,213" FontSize="20" Command="{Binding cmdmusica, Source={StaticResource cont}}" >Play</Button>
    </Grid>
</Window>
