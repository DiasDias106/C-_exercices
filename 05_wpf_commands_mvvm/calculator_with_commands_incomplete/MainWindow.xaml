<Window x:Class="calculadora1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:calculadora1"
        xmlns:ctrl="clr-namespace:calculadora1.Controller"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="700">
    <Window.Resources>
        <ctrl:Controlo x:Key="crtl"></ctrl:Controlo>
    </Window.Resources>
    <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Background="Coral">
                    <Menu DockPanel.Dock="top">
                        <MenuItem
                         Header="Sair" FontSize="20"
                         Command="{Binding cmdsair, Source={StaticResource crtl}}"/>
                    </Menu>
                </DockPanel>
                <TextBox x:Name="txtmostra" FontSize="30" Grid.Row="1" Grid.ColumnSpan="5" Margin="30" Foreground="red"></TextBox>
                <TextBox x:Name="txtcontas" FontSize="30" Grid.Row="2" Grid.ColumnSpan="5" Margin="30" Foreground="Red"></TextBox>
                <Button CommandParameter="7" Grid.Column="0" Grid.Row="3" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">7</Button>
                <Button CommandParameter="8" Grid.Column="1" Grid.Row="3" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">8</Button>
                <Button CommandParameter="9" Grid.Column="2" Grid.Row="3" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">9</Button>
                <Button CommandParameter="4" Grid.Column="0" Grid.Row="4" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">4</Button>
                <Button CommandParameter="5" Grid.Column="1" Grid.Row="4" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">5</Button>
                <Button CommandParameter="6" Grid.Column="2" Grid.Row="4" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">6</Button>
                <Button CommandParameter="1" Grid.Column="0" Grid.Row="5" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">1</Button>
                <Button CommandParameter="2" Grid.Column="1" Grid.Row="5" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">2</Button>
                <Button CommandParameter="3" Grid.Column="2" Grid.Row="5" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">3</Button>
                <Button Grid.Column="3" Grid.Row="3" Margin="10" FontSize="30">+</Button>
                <Button Grid.Column="3" Grid.Row="4" Margin="10" FontSize="30">-</Button>
                <Button Grid.Column="3" Grid.Row="5" Margin="10" FontSize="30">*</Button>
                <Button Grid.Column="3" Grid.Row="6" Margin="10" FontSize="30">/</Button>
                <Button Grid.Column="5" Grid.Row="6" Margin="10" FontSize="30">=</Button>
                <Button Grid.Column="1" Grid.Row="6" Margin="10" FontSize="30">%</Button>
                <Button CommandParameter="ca" Grid.Column="0" Grid.Row="6" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">CA</Button>
                <Button CommandParameter="," Grid.Column="2" Grid.Row="6" Margin="10" FontSize="30" Command="{Binding cmdoperandos, Source={StaticResource crtl}}">,</Button>
        <Frame x:Name="frame"></Frame>
            </Grid>
        </Window>
