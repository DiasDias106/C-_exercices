<Window x:Class="CalculadoraWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculadoraWPF"
        xmlns:ctrl="clr-namespace:CalculadoraWPF.Controller"
        mc:Ignorable="d"
        Background="black"
        Title="Calculadora" Height="800" Width="400">
    <Window.Resources>
        <ctrl:Controller x:Key="ctrl"></ctrl:Controller>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="143*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="txtmostra" Grid.Row="0" Margin="0,0,0,131" Grid.RowSpan="2"/>
        <TextBox x:Name="txtconta" Grid.Row="1" BorderBrush="#FF0040FF" Margin="0,0,0,65" Grid.RowSpan="2"/>
        <Button CommandParameter="7" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="4" Width="80" Height="50" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">7</TextBlock>
        </Button>
        <Button CommandParameter="8" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="4" Width="80" Height="50" Margin="95,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">8</TextBlock>
        </Button>
        <Button CommandParameter="9" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="4" Width="80" Height="50" Margin="180,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">9</TextBlock>
        </Button>
        <Button CommandParameter="x" Command="{Binding exeopera, Source={StaticResource ctrl}}" Grid.Row="4" Height="50" Margin="296,0,10,0" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold">x</TextBlock>
        </Button>
        <Button CommandParameter="4" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="5" Width="80" Height="50" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">4</TextBlock>
        </Button>
        <Button CommandParameter="5" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="5" Width="80" Height="50" Margin="95,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">5</TextBlock>
        </Button>
        <Button CommandParameter="6" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="5" Width="80" Height="50" Margin="180,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">6</TextBlock>
        </Button>
        <Button CommandParameter="-" Command="{Binding exeopera, Source={StaticResource ctrl}}" Grid.Row="5" Height="50" Margin="296,0,10,0" VerticalAlignment="Center">
            <TextBlock FontSize="24" FontWeight="Bold">-</TextBlock>
        </Button>
        <Button CommandParameter="1" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="6" Width="80" Height="50" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">1</TextBlock>
        </Button>
        <Button CommandParameter="2" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="6" Width="80" Height="50" Margin="95,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">2</TextBlock>
        </Button>
        <Button CommandParameter="3" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="6" Width="80" Height="50" Margin="180,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">3</TextBlock>
        </Button>
        <Button CommandParameter="+" Command="{Binding exeopera, Source={StaticResource ctrl}}" Grid.Row="6" Height="50" Margin="296,0,10,0" VerticalAlignment="Center" FontWeight="Bold">
            <TextBlock FontSize="20">+</TextBlock>
        </Button>
        <Button CommandParameter="/" Command="{Binding exeopera, Source={StaticResource ctrl}}" Grid.Row="7" Width="80" Height="50" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">/</TextBlock>
        </Button>
        <Button CommandParameter="0" Command="{Binding exenum, Source={StaticResource ctrl}}" Grid.Row="7" Width="80" Height="50" Margin="95,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">0</TextBlock>
        </Button>
        <Button CommandParameter="," Command="{Binding exefun, Source={StaticResource ctrl}}" Grid.Row="7" Width="80" Height="50" Margin="180,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="20">,</TextBlock>
        </Button>
        <Button CommandParameter="=" Command="{Binding exeopera, Source={StaticResource ctrl}}" Grid.Row="7" Height="50" Margin="296,0,10,0" VerticalAlignment="Center" FontWeight="Bold">
            <TextBlock FontSize="20" FontWeight="Bold">=</TextBlock>
        </Button>
    </Grid>
</Window>
