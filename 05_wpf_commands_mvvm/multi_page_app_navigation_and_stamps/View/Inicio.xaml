<Page x:Class="Wpf1.View.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf1.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      Title="Inicio">
    <Page.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0.067"/>
            <GradientStop Color="#FF1F1F12" Offset="0.833"/>
            <GradientStop Color="#FFF1F417" Offset="0.583"/>
            <GradientStop Color="#FFDCDF18" Offset="0.468"/>
        </LinearGradientBrush>
    </Page.Background>



    <Grid>
        <Image Margin="55" Source="/Imagens/6.jpg" ></Image>
        <TextBlock 
            TextAlignment="Center"
            VerticalAlignment="Center"
            Margin="55,0,55,0" 
            Text="APP I" 
   
            FontSize="55" Foreground="Yellow" 
            Height="104" FontFamily="Adobe Gothic Std B">
            <TextBlock.Background>
                <RadialGradientBrush>
                    <GradientStop Color="Black" Offset="0.151"/>
                    <GradientStop Color="Transparent" Offset="0.862"/>
                </RadialGradientBrush>
            </TextBlock.Background></TextBlock>
    </Grid>
</Page>
