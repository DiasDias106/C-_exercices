<Window x:Class="Wpf1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf1"
        xmlns:ctrl="clr-namespace:Wpf1.Controller"
        mc:Ignorable="d"
        Background="Black"
        Title="Aplicação I" Height="650" Width="800">
    <Window.Resources>
        <ctrl:ControllerI x:Key="ctrl"></ctrl:ControllerI>
        <Style x:Key="mnustyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Pink"></Setter>
            <Setter Property="Foreground" Value="Black"></Setter>
          
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                     <Setter Property="FontWeight" Value="Bold"></Setter>
                    <Setter Property="Foreground" Value="White"></Setter>
                </Trigger>
            </Style.Triggers>
                       
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="LightBlue">
            <Menu  DockPanel.Dock="Top" FontSize="22">
                <MenuItem     Style="{StaticResource mnustyle}" Header="File">
                    <MenuItem  
                         CommandParameter="Inicio"
 Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Style="{StaticResource mnustyle}" Header="Início"></MenuItem>
                    <Separator />
                    <MenuItem 
                        
                        Style="{StaticResource mnustyle}" 
                        Header="Sair" 
                        Command="{Binding cmdSair, Source={StaticResource ctrl}}" 
                        
                        >
                        
                    </MenuItem>
                </MenuItem>
                <MenuItem Style="{StaticResource mnustyle}"  Header="Aplicações">
                    <MenuItem  
                        CommandParameter="Selos"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Style="{StaticResource mnustyle}" Header="Selos"></MenuItem>
                    <MenuItem   
                        CommandParameter="Dados"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Style="{StaticResource mnustyle}" Header="Jogo Dados"></MenuItem>
                </MenuItem>

            </Menu>
        </DockPanel>
        <Frame NavigationUIVisibility="Visible" Grid.Row="1" x:Name="frame" Source="/View/Inicio.xaml" ></Frame>

    </Grid>
</Window>
