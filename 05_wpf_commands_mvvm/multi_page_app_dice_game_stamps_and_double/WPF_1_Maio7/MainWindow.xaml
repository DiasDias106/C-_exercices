<Window x:Class="WPF_1_Maio7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_1_Maio7"
        xmlns:controller="clr-namespace:WPF_1_Maio7.Controlers"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="700">

    <Window.Resources>
        <controller:Controller x:Key="ctrl"></controller:Controller>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="341*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Menu FontSize="23">
                <MenuItem Header="File">
                    <MenuItem
                        CommandParameter="Inicio"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Header="Início">
                        
                    </MenuItem>
                    <Separator/>
                    <MenuItem
                        CommandParameter="JogoDados"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Header="Jogo dos dados">
                    </MenuItem>
                    
                    <MenuItem
                        CommandParameter="Selos"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Header="Máquina de selos">
                        
                    </MenuItem>

                    <MenuItem
                        CommandParameter="Dobro"
                        Command="{Binding cmdNavegar, Source={StaticResource ctrl}}"
                        Header="Dobro">

                    </MenuItem>
                </MenuItem>

                <MenuItem
                    Command="{Binding cmdSair, Source={StaticResource ctrl}}"
                    Header="Sair"></MenuItem>
            </Menu>

        </DockPanel>

        <Frame
            Source="/Views/JogoDados.xaml" 
            Grid.Row="1" x:Name="frame">
            <!--Trocar para inicio outra vez /Views/Inicio.xaml-->
        </Frame>
        <StackPanel Grid.Row="2" Background="Black"></StackPanel>

    </Grid>
</Window>
