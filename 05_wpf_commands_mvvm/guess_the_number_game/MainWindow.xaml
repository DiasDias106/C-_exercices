<Window x:Class="adivinhar_numero.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:adivinhar_numero"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Image Source="/imagens/pensar.jpg" Grid.RowSpan="4" ></Image>
        <Label Content="Adivinhe um numero entre 1 e 1000" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" Foreground="Blue"></Label>
        <Label Content="coloque aqui o numero" Grid.Row="2" Grid.Column="1" HorizontalAlignment="center" VerticalAlignment="top" Foreground="Blue" FontSize="15" ></Label>
        <TextBox x:Name="txtmostra" FontSize="30" Grid.Row="2" Grid.Column="1" Width="400" Height="60" Text="{Binding Path= Value, ElementName=slider}"></TextBox>
        <Label Content="Reultdado" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="Blue" FontSize="15"></Label>
        <TextBox x:Name="txtresult" Grid.Row="3" Grid.Column="1" Width="400" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" ></TextBox>
        <Slider Margin="66,96,67,61" Minimum="1" Maximum="1000" Foreground="Magenta" IsSnapToTickEnabled="True"
                TickFrequency="1"
                TickPlacement="BottomRight"
                Grid.Row="3"
                Grid.Column="1"
                x:Name="slider"
                Width="400" Height="60" Grid.RowSpan="2" ></Slider>
        <Button Grid.Column="0" Grid.Row="4" Margin="15" Background="LightBlue" FontSize="20" >Verificar</Button>
        <Button  Grid.Column="1" Grid.Row="4" Width="300" Height="40" FontSize="20" Background="LightBlue">Limpar</Button>
    </Grid>
</Window>
