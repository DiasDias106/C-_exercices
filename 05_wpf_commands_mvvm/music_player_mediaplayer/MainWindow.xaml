<Window x:Class="musica2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:musica2"
        xmlns:ctrl="clr-namespace:musica2.controlo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ctrl:controller x:Key="cont"></ctrl:controller>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <MediaElement Grid.Row="0" Name="mediaElement"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform" Source="/musica/MONTAGEM - ASSOMBRA MATRIX 2 [ ÁLBUM BONES ].mp4"/>
        </Grid>
</Window>
