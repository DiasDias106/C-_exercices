<Window x:Class="Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora"
        mc:Ignorable="d"
        Background="Black"
        Title="Calculadora" Height="800" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="289*"/>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="157*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="4" Background="Blue">
            <Menu>
                <MenuItem Header="Opções">
                    <MenuItem Header="iniciar" FontWeight="bold"/>
                    <MenuItem Header="sair" FontWeight="Bold"/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <TextBox x:Name="txconta" Grid.ColumnSpan="4" Height="60" Width="400" Margin="150,60,150,120" Grid.Row="1"/>
        <Button Grid.Column="0" Grid.Row="2" Background="White" Margin="15">
            <TextBlock FontSize="50"> 1 </TextBlock>
        </Button>
        <Button Grid.Column="0" Grid.Row="3" Background="White" Margin="15">
            <TextBlock FontSize="50">2</TextBlock>
        </Button>
        <Button Grid.Column="0" Grid.Row="4" Background="White" Margin="15">
            <TextBlock FontSize="50"> 3</TextBlock>
        </Button>
        <Button Grid.Column="1" Grid.Row="2" Background="White" Margin="15">
            <TextBlock FontSize="50"> 4</TextBlock>
        </Button>
        <Button Grid.Column="1" Grid.Row="3" Background="White" Margin="15">
            <TextBlock FontSize="50"> 5</TextBlock>
        </Button>
        <Button Grid.Column="1" Grid.Row="4" Background="White" Margin="15">
            <TextBlock FontSize="50"> 6</TextBlock>
        </Button>
        <Button Grid.Column="2" Grid.Row="2" Background="White" Margin="15">
            <TextBlock FontSize="50"> 7</TextBlock>
        </Button>
        <Button Grid.Column="2" Grid.Row="3" Background="White" Margin="15">
            <TextBlock FontSize="50"> 8</TextBlock>
        </Button>
        <Button Grid.Column="2" Grid.Row="4" Background="White" Margin="15">
            <TextBlock FontSize="50"> 9</TextBlock>
        </Button>
        <Button Grid.Column="3" Grid.Row="2" Background="White" Margin="15">
            <TextBlock FontSize="50"> +</TextBlock>
        </Button>
        <Button Grid.Column="3" Grid.Row="3" Background="White" Margin="15">
            <TextBlock FontSize="50"> -</TextBlock>
        </Button>
        <Button Grid.Column="3" Grid.Row="4" Background="White" Margin="15">
            <TextBlock FontSize="50"> *</TextBlock>
        </Button>
        <Button Grid.Column="0" Grid.Row="5" Background="White" Margin="15">
            <TextBlock FontSize="50"> /</TextBlock>
        </Button>
        <Button Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" Background="Gray" Margin="5">
            <TextBlock FontSize="50"> = </TextBlock>
        </Button>


    </Grid>
</Window>
