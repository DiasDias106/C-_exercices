<Window x:Class="Dobro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dobro"
        xmlns:ctrl="clr-namespace:Dobro.Controller"
        mc:Ignorable="d"
        Background="black"
        Title="MainWindow" Height="700" Width="600">
    <Window.Resources>
        <ctrl:Controlo x:Key="ctrl"></ctrl:Controlo>
        <Style x:Key="mnustyle" TargetType="MenuItem">
            <Setter Property="Background" Value="White"></Setter>
            <Setter Property="Foreground" Value="Red"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="Gray">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="opção">
                    <MenuItem  Header="Sair" 
                     Command="{Binding execsair, Source={StaticResource ctrl}}">
                    </MenuItem>
                </MenuItem>
            </Menu>
        </DockPanel>
        <TextBox x:Name="txtconta" Margin="60" Grid.Row="2" Grid.ColumnSpan="7"/>
        <Button Grid.Column="1" Grid.Row="3" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">1</Button>
        <Button Grid.Column="3" Grid.Row="3" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">2</Button>
        <Button Grid.Column="5" Grid.Row="3" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">3</Button>
        <Button Grid.Column="1" Grid.Row="4" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">4</Button>
        <Button Grid.Column="3" Grid.Row="4" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">5</Button>
        <Button Grid.Column="5" Grid.Row="4" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">6</Button>
        <Button Grid.Column="1" Grid.Row="5" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">7</Button>
        <Button Grid.Column="3" Grid.Row="5" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">8</Button>
        <Button Grid.Column="5" Grid.Row="5" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">9</Button>
        <Button Grid.Column="3" Grid.Row="7" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">*</Button>
        <Button Grid.Column="5" Grid.Row="7" FontSize="50" Margin="10" HorizontalContentAlignment="center" VerticalContentAlignment="Center">=</Button>
        <TextBlock Grid.Row="1" FontSize="20" Grid.ColumnSpan="7" Background="Transparent" Foreground="Red" HorizontalAlignment="center" Text="Nome: Francisco Dias"/>
        <Image Source="/Imagens/imagem_c#.png" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="136,38,2,152" Grid.RowSpan="2" ></Image>
    </Grid>
</Window>
