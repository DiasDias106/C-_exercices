<Window x:Class="Calculadora_projeto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora_projeto"
        mc:Ignorable="d"
        Title="calculator" Height="800" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="65*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="4" Background="LightBlue">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Sair"></MenuItem>
            </Menu>
        </DockPanel>
        <TextBox x:Name="txtmostra" Grid.Row="1" Grid.ColumnSpan="4" Margin="30" Foreground="Blue"></TextBox>
        <TextBox x:Name="txtconta" Grid.Row="2" Grid.ColumnSpan="4" Margin="30" Foreground="Red"></TextBox>
        <Button Grid.Column="0" Margin="15" Grid.Row="4" Background="LightBlue" Foreground="Red">7</Button>
        <Button Grid.Column="1" Margin="15" Grid.Row="4" Background="LightBlue" Foreground="Red">8</Button>
        <Button Grid.Column="2" Margin="15" Grid.Row="4" Background="LightBlue" Foreground="Red">9</Button>
        <Button Grid.Column="3" Margin="15" Grid.Row="4" Background="LightBlue" Foreground="Red">+</Button>
        <Button Grid.Column="0" Margin="15" Grid.Row="5" Background="LightBlue" Foreground="Red">4</Button>
        <Button Grid.Column="1" Margin="15" Grid.Row="5" Background="LightBlue" Foreground="Red">5</Button>
        <Button Grid.Column="2" Margin="15" Grid.Row="5" Background="LightBlue" Foreground="Red">6</Button>
        <Button Grid.Column="0" Margin="15" Grid.Row="6" Background="LightBlue" Foreground="Red">1</Button>
        <Button Grid.Column="1" Margin="15" Grid.Row="6" Background="LightBlue" Foreground="Red">2</Button>
        <Button Grid.Column="2 " Margin="15" Grid.Row="6" Background="LightBlue" Foreground="Red">3</Button>
        
    </Grid>
</Window>
