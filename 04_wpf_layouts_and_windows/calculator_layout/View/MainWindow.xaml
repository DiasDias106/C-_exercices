<Window x:Class="calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:calculadora"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Background="Coral">
            <Menu DockPanel.Dock="top">
                <MenuItem Header="Sair"/>
            </Menu>
        </DockPanel>
        <TextBox x:Name="txtmostra" Grid.Row="1" Grid.ColumnSpan="5" Margin="30" Foreground="red"></TextBox>
        <TextBox x:Name="txtcontas" Grid.Row="2" Grid.ColumnSpan="5" Margin="30" Foreground="Red"></TextBox>
        <Button Grid.Column="0" Grid.Row="3" Margin="10" FontSize="30">7</Button>
        <Button Grid.Column="1" Grid.Row="3" Margin="10" FontSize="30">8</Button>
        <Button Grid.Column="2" Grid.Row="3" Margin="10" FontSize="30">9</Button>
        <Button Grid.Column="0" Grid.Row="4" Margin="10" FontSize="30">4</Button>
        <Button Grid.Column="1" Grid.Row="4" Margin="10" FontSize="30">5</Button>
        <Button Grid.Column="2" Grid.Row="4" Margin="10" FontSize="30">6</Button>
        <Button Grid.Column="0" Grid.Row="5" Margin="10" FontSize="30">1</Button>
        <Button Grid.Column="1" Grid.Row="5" Margin="10" FontSize="30">2</Button>
        <Button Grid.Column="2" Grid.Row="5" Margin="10" FontSize="30">3</Button>
        <Button Grid.Column="3" Grid.Row="3" Margin="10" FontSize="30">+</Button>
        <Button Grid.Column="3" Grid.Row="4" Margin="10" FontSize="30">-</Button>
        <Button Grid.Column="3" Grid.Row="5" Margin="10" FontSize="30">*</Button>
        <Button Grid.Column="3" Grid.Row="6" Margin="10" FontSize="30">/</Button>
        <Button Grid.Column="5" Grid.Row="6" Margin="10" FontSize="30">=</Button>
        <Button Grid.Column="1" Grid.Row="6" Margin="10" FontSize="30">%</Button>
        <Button Grid.Column="0" Grid.Row="6" Margin="10" FontSize="30">CA</Button>
        <Frame x:Name="frame"></Frame>
    </Grid>
</Window>
